{
  "name": "japan-bank-mcp",
  "version": "0.1.0",
  "description": "MCP server for Japanese bank and branch codes (全銀協 金融機関コード・支店コード), 全銀 kana account names and ゆうちょ 記号番号. Offline, no API keys.",
  "type": "module",
  "bin": {
    "japan-bank-mcp": "src/server.js"
  },
  "exports": "./src/index.js",
  "files": [
    "src",
    "data"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "data": "node scripts/build-data.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "japan",
    "japanese",
    "bank",
    "bank-code",
    "branch-code",
    "zengin",
    "furikomi",
    "claude",
    "codex",
    "金融機関コード",
    "支店コード",
    "全銀",
    "振込",
    "ゆうちょ"
  ],
  "author": "Ash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashkobo/japan-bank-mcp.git"
  },
  "homepage": "https://github.com/ashkobo/japan-bank-mcp#readme",
  "bugs": "https://github.com/ashkobo/japan-bank-mcp/issues",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "zengin-code": "1.0.0-p20260824"
  }
}
